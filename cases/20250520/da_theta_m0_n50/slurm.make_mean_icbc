#!/bin/bash
# Hourly unperturbed wrfinput files (real.exe, one time level per call) in the shared mean directory
# cases/20250520/da_common_theta_m0/mean/ (through this experiment's mean link): scripts/da/make_mean_icbc.sh
# writes ${MEAN_DIR}/wrfinput_d01_YYYY-MM-DD_HH_00_00, skipping hours whose file exists. Adapted from the
# pilot's da_theta_m0_n5/slurm.make_mean_icbc (which made all 73 hours, 2026-09-29).
# A4 of notes/fulltest_steps.md (2026-11-06): 05-20 00Z only (hour 24), again, with REFL_10CM in wrfinput
# (namelist.input.real names iofields_real.txt), after the old file was moved to *.pre_refl:
#   FIRST_HOUR=24 LAST_HOUR=24 sbatch slurm.make_mean_icbc
# Layout as in theta_m0 real.exe (16 ranks x 8 OpenMP threads per node), on 4 nodes.
#SBATCH --job-name=mean520
#SBATCH -A cli120
#SBATCH --partition=batch_all
#SBATCH --time=00:30:00
#SBATCH --nodes=4
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=8
#SBATCH --output=logs/slurm.make_mean_icbc.%j.out
#SBATCH --exclusive

PROJECT_DIR=/gpfs/wolf2/arm/cli120/proj-shared/hengxiao80/bnf_wrf_da
FIRST_HOUR=${FIRST_HOUR:?set FIRST_HOUR and LAST_HOUR (offsets from CASE_START, 0-72)}
LAST_HOUR=${LAST_HOUR:?set FIRST_HOUR and LAST_HOUR (offsets from CASE_START, 0-72)}

date
source ${PROJECT_DIR}/scripts/env_wrf.sh

# real.exe UCX setting, as in the existing slurm.real scripts (from sey's real.exe job).
# wrf.exe jobs use a different setting (see slurm.wrf); don't mix them.
export UCX_TLS=rc,xpmem,self
export OMP_NUM_THREADS=8
export OMP_PLACES=cores
export OMP_PROC_BIND=true
export OMP_STACKSIZE=64000000
ulimit -s unlimited

${PROJECT_DIR}/scripts/da/make_mean_icbc.sh \
   ${PROJECT_DIR}/cases/20250520/da_theta_m0_n50/config/experiment.sh "${FIRST_HOUR}" "${LAST_HOUR}"
status=$?
date
exit ${status}
