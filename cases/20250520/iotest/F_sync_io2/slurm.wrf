#!/bin/bash
# Generated by scripts/make_wrf_iotest.py -- variant F_sync_io2
#SBATCH --job-name=ioF
#SBATCH -A cli120
#SBATCH --partition=priority_long
#SBATCH --time=00:45:00
#SBATCH --nodes=32
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=8
#SBATCH --output=slurm.wrf.out
#SBATCH --exclusive

date
source /gpfs/wolf2/arm/cli120/proj-shared/hengxiao80/bnf_wrf_da/scripts/env_wrf.sh
cd $SLURM_SUBMIT_DIR
rm -f rsl.out.* rsl.error.*

export UCX_TLS=self,sm,ud
export UCX_UD_MLX5_RX_QUEUE_LEN=16384
export OMP_NUM_THREADS=8
export OMP_PLACES=cores
export OMP_PROC_BIND=true
export OMP_STACKSIZE=64000000
ulimit -s 64000000

srun -n 512 --cpu_bind=cores ./wrf.exe

mkdir -p rsls
mv rsl.*.* rsls/
date
