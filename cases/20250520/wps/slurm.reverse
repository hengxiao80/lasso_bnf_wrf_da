#!/bin/bash
# DRAFT for review -- not submitted. Run AFTER metgrid finishes.
# Flips the vertical order of the 73 met_em files (see scripts/reverse_metgridlevs.py);
# originals are kept in ./raw_metgrid/. Uses the project venv directly (no `uv run`,
# which could try to reach the network from a compute node).
#SBATCH --job-name=rev520
#SBATCH -A cli120
#SBATCH --partition=batch_all
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --output=slurm.reverse.out

date
cd $SLURM_SUBMIT_DIR
PROJ=/gpfs/wolf2/arm/cli120/proj-shared/hengxiao80/bnf_wrf_da
$PROJ/.venv/bin/python $PROJ/scripts/reverse_metgridlevs.py . --workers 16
date
