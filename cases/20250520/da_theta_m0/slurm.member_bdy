#!/bin/bash
# Per-member boundary files for the pilot (step 6): scripts/da/build_member_bdy.py writes the mean
# subset (2 records from 05-20 00Z) and bdy/wrfbdy_d01_memNNN by running pert_wrf_bc (serial) once
# per member and record, members in parallel. First the unperturbed refit (--zero-pert), which should
# reproduce the real.exe boundary values, then the members, then the check script.
#   sbatch slurm.member_bdy
# Serial programs only, so one node; no MPI and no UCX setting.
#SBATCH --job-name=bdy520
#SBATCH -A cli120
#SBATCH --partition=batch_all
#SBATCH --time=01:00:00
#SBATCH --nodes=1
#SBATCH --output=slurm.member_bdy.%j.out
#SBATCH --exclusive

PROJECT_DIR=/gpfs/wolf2/arm/cli120/proj-shared/hengxiao80/bnf_wrf_da
EXP_DIR=${PROJECT_DIR}/cases/20250520/da_theta_m0
PY=${PROJECT_DIR}/.venv/bin/python

date
source ${PROJECT_DIR}/scripts/env_wrf.sh
ulimit -s unlimited
set -e

${PY} ${PROJECT_DIR}/scripts/da/build_member_bdy.py ${EXP_DIR} --zero-pert
date
${PY} ${PROJECT_DIR}/scripts/da/build_member_bdy.py ${EXP_DIR} --nmem 5 --jobs 5
date
${PY} ${PROJECT_DIR}/scripts/da/check_member_bdy.py ${EXP_DIR} --nmem 5
date
