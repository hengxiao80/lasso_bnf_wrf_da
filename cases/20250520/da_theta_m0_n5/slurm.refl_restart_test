#!/bin/bash
# Test of the REFL_10CM-in-restart WRF patch (patches/wrf_06d4240a_refl_10cm_restart.patch, rebuilt
# 2026-10-14; notes/obs_expansion.md Sec. 8.4 step 5). All three runs use the patched wrf.exe:
#   continuous: 30 min from the mean 05-20 00Z wrfinput, wrfout and wrfrst every 15 min
#   from_old:   restart from the PRE-PATCH 00:15 wrfrst of the step-7 test (no REFL_10CM), 15 min
#   from_new:   restart from continuous's new 00:15 wrfrst, 15 min
# Same 2-record mean boundary subset as slurm.true_restart_test. check_refl_restart.py then checks
# that REFL_10CM is in the new wrfrst and equals wrfout, that the rebuild changed nothing else
# (new vs pre-patch wrfrst at 00:15), and that from_old and from_new agree at 00:30.
#   sbatch slurm.refl_restart_test
#SBATCH --job-name=rflrst
#SBATCH -A cli120
#SBATCH --partition=batch_all
#SBATCH --time=01:00:00
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=8
#SBATCH --output=slurm.refl_restart_test.%j.out
#SBATCH --exclusive

PROJECT_DIR=/gpfs/wolf2/arm/cli120/proj-shared/hengxiao80/bnf_wrf_da
SCRIPT_DIR=${SCRIPT_DIR:-${PROJECT_DIR}/scripts/da}
EXP_SH=${PROJECT_DIR}/cases/20250520/da_theta_m0/config/experiment.sh
source ${EXP_SH}
TEST_DIR=${EXP_DIR}/tests/refl_restart
OLD_RST=${EXP_DIR}/tests/true_restart/continuous/wrfrst_d01_2025-05-20_00_15_00
BDY=${EXP_DIR}/bdy/wrfbdy_d01_mean_2025-05-20_00_2h

date
source ${PROJECT_DIR}/scripts/env_wrf.sh
set -e
sha256sum $(readlink -f ${WRF_RUN_DIR}/wrf.exe)

# wrf.exe UCX settings, as in the existing slurm.wrf scripts; don't mix with real.exe's.
export UCX_TLS=self,sm,ud
export UCX_UD_MLX5_RX_QUEUE_LEN=16384
export OMP_NUM_THREADS=8
export OMP_PLACES=cores
export OMP_PROC_BIND=true
export OMP_STACKSIZE=64000000
ulimit -s 64000000

RESTART=.false. RESTART_INTERVAL=15 ${SCRIPT_DIR}/run_wrf_segment.sh ${EXP_SH} ${TEST_DIR}/continuous \
   2025-05-20_00:00:00 1800 ${MEAN_DIR}/wrfinput_d01_2025-05-20_00_00_00 ${BDY} 16 8
RESTART=.true. RESTART_INTERVAL=15 ${SCRIPT_DIR}/run_wrf_segment.sh ${EXP_SH} ${TEST_DIR}/from_old \
   2025-05-20_00:15:00 900 ${OLD_RST} ${BDY} 16 8
RESTART=.true. RESTART_INTERVAL=15 ${SCRIPT_DIR}/run_wrf_segment.sh ${EXP_SH} ${TEST_DIR}/from_new \
   2025-05-20_00:15:00 900 ${TEST_DIR}/continuous/wrfrst_d01_2025-05-20_00_15_00 ${BDY} 16 8

for d in continuous from_old from_new; do
   echo "== ${d}: rsl.error.0000 warnings and REFL_10CM mentions"
   grep -i -E 'warn|missing|not found|error|refl_10cm' ${TEST_DIR}/${d}/rsl.error.0000 | sort | uniq -c | head -30 || true
   grep -E 'Timing for (processing restart|Writing restart)' ${TEST_DIR}/${d}/rsl.error.0000 || true
done
ls -l ${TEST_DIR}/*/wrfrst_d01_* ${OLD_RST}

${PROJECT_DIR}/.venv/bin/python ${SCRIPT_DIR}/check_refl_restart.py ${TEST_DIR} ${OLD_RST}
date
