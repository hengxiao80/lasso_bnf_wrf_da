#!/bin/bash
# use_theta_m=0 comparison run (hybrid_opt=0); everything else as ../baseline.
# Configuration chosen from the I/O tests in ../iotest (variant K): plain classic netCDF
# history (io_form_history=2, use_netcdf_classic), 16 nodes with a 16x16 decomposition.
# Projected ~3.7 h wall (30-min tests: ~0.22 s/step compute, ~5 s per 15-min history write).
# 12 h limit for headroom.
#SBATCH --job-name=wrf520thm0
#SBATCH -A cli120
#SBATCH --partition=priority_long
#SBATCH --time=12:00:00
#SBATCH --nodes=16
#SBATCH --ntasks-per-node=16
#SBATCH --cpus-per-task=8
#SBATCH --output=slurm.wrf.out
#SBATCH --exclusive

date
source /gpfs/wolf2/arm/cli120/proj-shared/hengxiao80/bnf_wrf_da/scripts/env_wrf.sh
cd $SLURM_SUBMIT_DIR
rm -f rsl.out.* rsl.error.*

# Keep these UCX settings: without them larger runs (e.g. the 500-m domains, which have
# more grid points than this 2.5-km one) fail on MPI communication. They don't affect
# speed at 2.5 km, but they must stay in every WRF job script.
export UCX_TLS=self,sm,ud
export UCX_UD_MLX5_RX_QUEUE_LEN=16384
export OMP_DISPLAY_ENV=true
export OMP_NUM_THREADS=8
export OMP_PLACES=cores
export OMP_PROC_BIND=true
export OMP_STACKSIZE=64000000
ulimit -s 64000000

srun -n 256 --cpu_bind=cores ./wrf.exe

mkdir -p rsls
mv rsl.*.* rsls/
date
