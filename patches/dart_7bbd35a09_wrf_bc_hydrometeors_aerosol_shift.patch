--- a/models/wrf/WRF_BC/pert_wrf_bc.f90
+++ b/models/wrf/WRF_BC/pert_wrf_bc.f90
@@ -105,7 +105,11 @@ tenname(3)='_BTYS'
 tenname(4)='_BTYE'
 
 !--3D need update
-nmoist = 7 
+! bnf_wrf_da local patch: refit QVAPOR only (nmoist = 1, was 7). QCLOUD, QRAIN, QICE, QSNOW,
+! QGRAUP and QNICE keep the values in wrfbdy (zero from real.exe), as in our free runs, instead
